# Your Wassist API key. Create one at https://wassist.app/settings/developers/api-keys/.
# Used by the stdio server. The HTTP server reads the key from each request instead.
WASSIST_API_KEY=

# Set to true to hide every tool that changes data or sends messages.
# WASSIST_READ_ONLY=false

# Load only some groups of tools, to keep the model's context small. Leave unset for all of them.
# Groups: agents, testing, whatsapp, conversations. For building agents, try agents,testing.
# WASSIST_TOOLSETS=

# HTTP server only (npm run start:http).
# PORT=8080
# BIND_ADDRESS=127.0.0.1
# ALLOWED_HOSTS=your-tunnel-domain.example.com

# Sign-in for clients that cannot send a key, such as ChatGPT and Claude.ai.
# PUBLIC_URL is the address clients use to reach the server, with no path. Setting it turns the sign-in on.
# OAUTH_SECRET keeps sign-ins alive across restarts. Use a random value of 32 or more characters.
# OAUTH_REDIRECT_HOSTS limits which apps can receive a sign-in, for example claude.ai,claude.com. Recommended for a public address.
# PUBLIC_URL=https://your-tunnel-domain.example.com
# OAUTH_REDIRECT_HOSTS=
# OAUTH_SECRET=
